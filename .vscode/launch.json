{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "TS-DEBUG",
      "skipFiles": ["<node_internals>/**"],
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "CI": "true"
      }
    }
  ]
}
